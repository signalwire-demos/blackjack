# Blackjack Dealer Configuration
# =============================================================================

# SignalWire Credentials (required for WebRTC calling)
SIGNALWIRE_SPACE_NAME=your-space
SIGNALWIRE_PROJECT_ID=your-project-id
SIGNALWIRE_TOKEN=your-api-token

# Public URL for SWML callbacks (required for WebRTC calling)
# This should be your publicly accessible URL (e.g., ngrok, dokku domain)
SWML_PROXY_URL_BASE=https://your-app.example.com

# Basic Auth for SWML endpoints (auto-generated if not set)
# SWML_BASIC_AUTH_USER=signalwire
# SWML_BASIC_AUTH_PASSWORD=your-secure-password

# Agent Configuration
# Fabric resource name; the dialable address becomes /public/{AGENT_NAME}.
# Use a DISTINCT name (e.g. blackjack-dev) for local runs -- startup UPDATES the
# URL of the handler with this name, so a shared name repoints other consumers.
AGENT_NAME=blackjack

# Server Configuration
PORT=5000

# Optional: Post-prompt webhook URL for session summaries
# POST_PROMPT_URL=https://your-webhook-url.com/blackjack/summary
